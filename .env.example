# OpenAI backend (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Runtime defaults
TRANSCRIBE_TIMEOUT_SECONDS=0
TRANSCRIBE_LOG_LEVEL=INFO
TRANSCRIBE_LOG_FILE=
TRANSCRIBE_PROGRESS_LOG_SECONDS=20
TRANSCRIBE_CHUNK_MODE=auto
TRANSCRIBE_CHUNK_SECONDS=1800
TRANSCRIBE_CHUNK_THRESHOLD_MINUTES=45
OPENAI_MAX_FILE_MB=24

# Refine stage (opt-in): fix ASR errors with Claude via the logged-in Claude Code CLI
TRANSCRIBE_REFINE=0
TRANSCRIBE_REFINE_MODEL=sonnet
# Optional path to the claude binary (default: `claude` on PATH)
CLAUDE_BIN=
